        <mxCell id="__dm_qY9HvUksueum9cR-19" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="Fetching for Nigeria temperature data was done utilizing the ecmwfr R package to access the Climate Data Store (CDS)" vertex="1">
