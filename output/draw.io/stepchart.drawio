          <mxGeometry height="109.02" width="110" x="-968.75" y="690" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-45" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="69.78260869565219" width="74.82000000000005" x="-858.75" y="210" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-44" parent="__dm_qY9HvUksueum9cR-45" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;kubernetesLabel=1;prIcon=api" value="" vertex="1">
