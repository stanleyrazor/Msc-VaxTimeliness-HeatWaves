        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-25" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="For each given DHS cluster, a time series index Mt is constructed using the training data and contains the annual maximum values from 1940 to 2019. Each cluster therefore ends up with 80 data points" vertex="1">
          <mxGeometry height="80" width="240" x="-560.46" y="670" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-34" parent="1" style="line;strokeWidth=2;html=1;" value="" vertex="1">
          <mxGeometry height="10" width="240" x="-358" y="810" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-35" parent="1" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#0075E8;fontSize=15;fontColor=#FFFFFF;size=0.5093750000000015;verticalAlign=top;strokeColor=none;direction=west;" value="Stage 4" vertex="1">
          <mxGeometry height="40" width="160" x="-68" y="827" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-36" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="For each given DHS cluster, the Tx5x data is then split into the training set and a testing set. The training set spans the period 1940 to 2019, while the testing set spans the period 2020 to 2024" vertex="1">
          <mxGeometry height="80" width="230" x="-93" y="873.27" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-37" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
