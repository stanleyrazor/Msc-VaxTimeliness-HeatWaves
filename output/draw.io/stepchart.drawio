        <mxCell id="__dm_qY9HvUksueum9cR-41" parent="1" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#0075E8;fontSize=15;fontColor=#FFFFFF;size=0.5093750000000015;verticalAlign=top;strokeColor=none;direction=west;" value="Stage 6" vertex="1">
