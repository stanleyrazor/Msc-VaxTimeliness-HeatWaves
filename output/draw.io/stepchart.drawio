        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-42" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="For each DHS cluster, a Generalized Extreme Value (GEV) regression model is fitted to the 80 data points, utilizing the Global Mean Surface Temperature (GMST) as a covariate, and the estimates of the interept, slope, scale and shape are obtained per cluster" vertex="1">
          <mxGeometry height="60" width="230" x="-1015" y="920.5" as="geometry" />
        </mxCell>
