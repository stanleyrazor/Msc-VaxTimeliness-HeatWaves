        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-20" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="This results in daily data for each 28 km squared grid for the period 1940-2024" vertex="1">
          <mxGeometry height="50" width="240" x="-1020" y="286" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-21" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="For each given DHS cluster, a time series index denoted Tx5x was constructed, as the 5-day rolling average temperature from 1940 to 2024" vertex="1">
          <mxGeometry height="60" width="210" x="-96" y="114.68999999999997" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-22" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;clipPath=inset(13.22% 0% 0% 0.73%);" value="" vertex="1">
          <mxGeometry height="117.69" width="204" x="-90" y="252.16" as="geometry" />
