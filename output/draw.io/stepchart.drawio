        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-4" parent="__dm_qY9HvUksueum9cR-45" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/sql_server.svg;" value="" vertex="1">
          <mxGeometry height="59.78260869565217" width="46.03260869565217" y="10" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-48" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="For each DHS cluster, its fitted GEV model was used to estimate the 10-year return level (90th percentile). Each 5-day rolling temperature observed during the testing period (2020-2024) was then compared with this threshold. Temperatures exceeding the estimated 10-year return level were classified as heatwave events, while those below the threshold were classified as non-heatwave events. " vertex="1">
          <mxGeometry height="80" width="320" x="-1060" y="1275" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-49" parent="1" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#0075E8;fontSize=15;fontColor=#FFFFFF;size=0.5;verticalAlign=top;strokeColor=none;" value="Stage 7" vertex="1">
          <mxGeometry height="40" width="160" x="-981" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-52" parent="1" style="text;whiteSpace=wrap;" value="This procedure produced a daily binary time series for each DHS cluster over the period 2020–2024, indicating the occurrence (1) or absence (0) of a heatwave." vertex="1">
          <mxGeometry height="50" width="310" x="-1058" y="1587.89" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-53" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;clipPath=inset(19.44% 8.03% 18.98% 55.03%);" value="" vertex="1">
          <mxGeometry height="167.89" width="179" x="-990.5" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-54" parent="1" style="line;strokeWidth=2;html=1;direction=south;" value="" vertex="1">
          <mxGeometry height="240" width="10" x="-918.75" y="990" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-56" parent="1" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#0075E8;fontSize=15;fontColor=#FFFFFF;size=0.5093750000000015;verticalAlign=top;strokeColor=none;direction=west;" value="Stage 2" vertex="1">
          <mxGeometry height="40" width="160" x="-520.4599999999999" y="247.19" as="geometry" />
        </mxCell>
        <mxCell id="__dm_qY9HvUksueum9cR-57" parent="1" style="text;whiteSpace=wrap;verticalAlign=bottom;fontColor=default;" value="In this step, the DHS records are linked to the daily temperature data using the geographic location. Record linkage is performed by matching each DHS cluster to temperature data within a 10 km buffer to account for the random displacement of DHS cluster coordinates. This is in line with DHS methodology." vertex="1">
          <mxGeometry height="80" width="260" x="-560" y="311.53" as="geometry" />
        </mxCell>
        <mxCell id="S_2TxlN20CKCSCZK4AKu-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="For each child then, heatwave exposure is determined within a 14-day window centred on the vaccine due date (7 days before to 7 days after).&amp;nbsp; A child is classified as exposed if at least one heatwave occurs within this window; otherwise, the child is classified as unexposed. The resulting dataset consists of the original DHS child records with an additional binary heatwave exposure variable." vertex="1">
          <mxGeometry height="50" width="250" x="-565.46" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="S_2TxlN20CKCSCZK4AKu-6" parent="1" style="line;strokeWidth=2;html=1;" value="" vertex="1">
          <mxGeometry height="10" width="240" x="-806.46" y="810" as="geometry" />
        </mxCell>
